# Credential-free backend example. Do not overwrite an existing .env.
# Local .env is read from the backend working directory; OS environment wins.
BACKEND_ENV=development
HOST=0.0.0.0
PORT=8000
WORKERS=1
RELOAD=false
LOG_LEVEL=info
DATABASE_URL=sqlite+aiosqlite:///./smart_navigator_spb.db
ALLOWED_ORIGINS=[]
TRUSTED_PROXY_IPS=
SERVER_CONCURRENCY_LIMIT=100
REQUEST_MAX_BYTES=16384
REQUEST_BODY_TIMEOUT_SECONDS=10
QUERY_MAX_BYTES=2048
READINESS_TIMEOUT_SECONDS=2
# Optional server-only keys: blank leaves catalogue and Smart Walk available.
GEOCODER_API_KEY=
SUGGEST_API_KEY=
YANDEX_TIMEOUT_SECONDS=5
YANDEX_CONNECT_TIMEOUT_SECONDS=3
YANDEX_MAX_CONCURRENT=4
YANDEX_SERVER_RATE_LIMIT=60
YANDEX_RATE_WINDOW_SECONDS=60
# Rolling 24 hours, conservative outbound-attempt budgets, not provider reset.
# Set 0 to disable a product. Shared keys / other apps require lower budgets.
YANDEX_SUGGEST_DAILY_BUDGET=800
YANDEX_GEOCODER_DAILY_BUDGET=800
SEARCH_CLIENT_RATE_LIMIT=30
SEARCH_CLIENT_WINDOW_SECONDS=60
SEARCH_CLIENT_MAX_ENTRIES=4096
# Phase C7.2 Puddle Risk: read-only pilot OSM ways snapshot (empty disables).
PUDDLE_WAYS_DATASET=data/puddle_ways_spb_pilot.json
PUDDLE_MAX_CONCURRENT_ANALYSES=2
PUDDLE_ANALYSIS_TIMEOUT_SECONDS=10
# Modeled weather is an explicit opt-in: the Open-Meteo free tier is
# non-commercial only; see docs/PHASE_C7_2_DATA_PROVENANCE.md before enabling.
PUDDLE_WEATHER_ENABLED=false
PUDDLE_WEATHER_TIMEOUT_SECONDS=6
PUDDLE_WEATHER_LATITUDE=59.9405
PUDDLE_WEATHER_LONGITUDE=30.3165
# Phase C7.3 Pollen Exposure: modeled CAMS pollen via Open-Meteo Air Quality.
# The source is an explicit opt-in: the free tier is non-commercial and requires
# attribution; see docs/PHASE_C7_3_SOURCE_FEASIBILITY.md before enabling.
POLLEN_MAX_CONCURRENT_ANALYSES=2
POLLEN_ANALYSIS_TIMEOUT_SECONDS=10
POLLEN_SOURCE_ENABLED=false
POLLEN_SOURCE_TIMEOUT_SECONDS=10
POLLEN_SOURCE_LATITUDE=59.9405
POLLEN_SOURCE_LONGITUDE=30.3165
# Phase C11 Quiet Engine: pinned central-SPb OSM road snapshot (ODbL-1.0).
# Disabled by default; enable only with the packaged, manifest-verified dataset.
QUIET_ENGINE_ENABLED=false
QUIET_DATASET=data/quiet_spb_pilot.json.gz
QUIET_DATASET_MANIFEST=data/quiet_spb_pilot.manifest.json
QUIET_MAX_CONCURRENT_ANALYSES=2
QUIET_ANALYSIS_TIMEOUT_SECONDS=10
# Phase C13 AI assistant: free OpenRouter models only, disabled by default.
# An operator must set ENABLED=true and an operator access-code SHA-256 hash;
# guest_limited additionally requires the data-collection acknowledgement and a
# source salt. Secrets are never stored here, only their SHA-256 hashes.
# Full reference: docs/CONFIGURATION.md.
AI_ASSISTANT_ENABLED=false
AI_ASSISTANT_ACCESS_MODE=private_test
AI_ASSISTANT_ACCESS_CODE_HASH=
AI_ASSISTANT_SOURCE_SALT=
AI_ASSISTANT_PRIVACY_NOTICE_VERSION=smartnavigator.ai_consent.v1
AI_ASSISTANT_STREAMING_ENABLED=true
AI_ASSISTANT_GLOBAL_PER_MINUTE=8
AI_ASSISTANT_GLOBAL_PER_DAY=100
AI_ASSISTANT_SOURCE_PER_MINUTE=3
AI_ASSISTANT_SOURCE_PER_DAY=20
AI_ASSISTANT_MAX_CONCURRENT=2
OPENROUTER_API_KEY=
